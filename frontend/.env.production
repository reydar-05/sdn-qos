# Used by "npm run build" (production build, e.g. the Vercel deployment).
# A public deployment has no lab behind it, so it opens in DEMO MODE.
# Viewers can still switch to LIVE LAB (it then shows an error state unless
# a backend is reachable). Override on Vercel under Settings > Environment Variables.
VITE_DEFAULT_MODE=demo
VITE_API_BASE_URL=http://127.0.0.1:5000
