# Copy this file to config/environment.env and adjust if needed.
# All services bind to 127.0.0.1 only - never expose these outside the VM.

# OpenFlow: Ryu controller listens here, OVS switches connect to it.
OPENFLOW_HOST=127.0.0.1
OPENFLOW_PORT=6653

# Ryu's own REST API (only used if/when an app in sdn/ enables it).
RYU_REST_HOST=127.0.0.1
RYU_REST_PORT=8080

# Flask backend: receives metrics/events pushed by Ryu, serves the dashboard.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# React/Vite dev server.
VITE_HOST=127.0.0.1
VITE_PORT=5173

# Video flow: iperf3 UDP acts as the video traffic to be identified by port.
VIDEO_PORT=5004

# DEMO_MODE=1 clearly labels all data on the dashboard as simulated.
# LIVE mode (DEMO_MODE=0) must show an error state if real data is
# unavailable - it must never silently fall back to demo data.
DEMO_MODE=1

# --- Backend API (Phase 4) ---
# Optional token. If set, every /api route except /api/health needs the
# header "Authorization: Bearer <token>". The controller and the
# dashboard read it from here too. Leave empty for local-only use.
SDN_QOS_API_TOKEN=
# Browser origins allowed to call the API (comma separated). Add your
# Vercel address (e.g. https://sdn-qos.vercel.app) to use LIVE LAB from the
# deployed site in a browser on this VM.
SDN_QOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Where the controller pushes metrics; 'off' disables pushing.
SDN_QOS_BACKEND_URL=http://127.0.0.1:5000
